rules_version = '2';

// 초안: docs/SECURITY.md의 "배포 전 확인"을 마치기 전에는 실제 사용자 데이터에 쓰지 않는다.
service firebase.storage {
  match /b/{bucket}/o {

    // 방 멤버인가. Firestore의 members 문서 존재 여부로 판단한다.
    function isMember(roomId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }

    // 결과 공개 시각(resultAt)이 지났는가. 값이 없으면 아직 공개 전으로 본다.
    function resultsOpen(roomId) {
      let resultAt = firestore.get(/databases/(default)/documents/rooms/$(roomId)).data.get('resultAt', null);
      return resultAt != null && resultAt <= request.time;
    }

    // 미션 인증 사진: rooms/{roomId}/submissions/{uid}/{submissionId}.jpg
    match /rooms/{roomId}/submissions/{uid}/{fileName} {
      // 결과 공개 전에는 본인 사진만, 공개 후에는 같은 방 멤버만 읽을 수 있다.
      allow read: if isMember(roomId) && (
        request.auth.uid == uid
        || resultsOpen(roomId)
      );

      // 본인 폴더에만, JPEG 5MB 미만으로 올릴 수 있다. (같은 경로에 올리면 교체)
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && isMember(roomId)
        && fileName.matches('.*\\.jpg')
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 5 * 1024 * 1024;

      // 삭제는 서버(보관 기간 정리)만 한다.
      allow delete: if false;
    }

    // 위에 없는 모든 경로는 차단
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
