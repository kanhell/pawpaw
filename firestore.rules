rules_version = '2';

// 초안: docs/SECURITY.md의 "배포 전 확인"을 마치기 전에는 실제 사용자 데이터에 쓰지 않는다.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 공통 함수 ----------
    function signedIn() {
      return request.auth != null;
    }

    function roomData(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data;
    }

    function isMember(roomId) {
      return signedIn()
        && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }

    function isHost(roomId) {
      return signedIn() && roomData(roomId).hostId == request.auth.uid;
    }

    // 결과 공개 시각(resultAt)이 지났는가. 값이 없으면 아직 공개 전으로 본다.
    function resultsOpen(roomId) {
      let resultAt = roomData(roomId).get('resultAt', null);
      return resultAt != null && resultAt <= request.time;
    }

    // 미션 수행 마감(deadlineAt) 전인가. 값이 없으면 마감 없음으로 본다.
    function beforeDeadline(roomId) {
      let deadlineAt = roomData(roomId).get('deadlineAt', null);
      return deadlineAt == null || request.time < deadlineAt;
    }

    // ---------- users ----------
    match /users/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.id == uid;
      allow delete: if false;
    }

    // ---------- missions (기본 제공 목록) ----------
    match /missions/{missionId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---------- rooms ----------
    match /rooms/{roomId} {
      // 게임을 시작할 수 있는 최소 인원. (packages/shared의 MIN_PLAYERS와 같은 값)
      function minPlayers() {
        return 3;
      }

      // 방장의 수정. 방장 자체와 멤버 수(memberCount)는 바꿀 수 없고,
      // 대기(waiting)에서 게임을 시작할 때는 멤버가 최소 인원 이상이어야 한다.
      function validHostUpdate() {
        let before = resource.data;
        let after = request.resource.data;
        return after.hostId == before.hostId
          && after.get('memberCount', 0) == before.get('memberCount', 0)
          && (
            before.status != 'waiting'
            || after.status == 'waiting'
            || after.get('memberCount', 0) >= minPlayers()
          );
      }

      // 초대로 참가하는 사람의 수정: 멤버 수를 1 늘리는 것만, 내 멤버 문서를 새로 만드는 같은 batch에서만.
      // (멤버 문서 생성은 validJoin이 검사하고, 이미 멤버면 다시 늘릴 수 없다)
      function validJoinCount() {
        let before = resource.data;
        let after = request.resource.data;
        return signedIn()
          && after.diff(before).affectedKeys().hasOnly(['memberCount'])
          && after.memberCount == before.get('memberCount', 0) + 1
          && before.status == 'waiting'
          && !exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid))
          && existsAfter(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
      }

      allow get: if isMember(roomId);
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.status == 'waiting'
        && request.resource.data.memberCount == 1;
      allow update: if (isHost(roomId) && validHostUpdate()) || validJoinCount();
      allow delete: if false;

      // 방 멤버(Player). 문서 ID = Firebase Auth uid
      match /members/{uid} {
        // 초대 링크로 참가하는 경우: 유효한 초대 코드를 문서에 담아 본인 문서를 만든다.
        // 코드는 방장만 읽을 수 있는 invites 문서의 존재 여부(exists)로 확인한다.
        function validJoin() {
          let d = request.resource.data;
          let code = d.get('inviteCode', null);
          return d.keys().hasOnly(['id', 'roomId', 'userId', 'animal', 'isHost', 'joinedAt', 'inviteCode'])
            && d.id == uid
            && d.userId == uid
            && d.roomId == roomId
            && d.isHost == false
            && d.joinedAt == request.time
            && code is string
            && code.matches('[A-Za-z0-9]{24}')
            && roomData(roomId).status == 'waiting'
            && exists(/databases/$(database)/documents/rooms/$(roomId)/invites/$(code));
        }

        // 본인 문서에서 바꿀 수 있는 것은 두 가지뿐이다.
        // (동물 캐릭터는 방 안에서 겹치지 않게 animals 문서와 묶여 있어서 참가한 뒤에는 바꾸지 않는다)
        // - assignmentDone: '미션을 정했어요' 표시. true로만, 미션지정 단계(phase = assign)에서만.
        //   (docs/MISSION_ASSIGN.md)
        // - submitted: '제출했어요' 표시. true로만, 내 제출 문서(s-a-내uid)가 이미 있을 때만.
        //   다른 멤버에게 "제출했는지"만 알려 주는 용도이며, 사진 경로나 시각은 담지 않는다.
        //   (docs/RESULT_REVEAL.md)
        // - resultEntered: '결과 화면에 들어왔어요' 표시. true로만, 결과가 열린 뒤에만.
        // - showcaseNext: 미션 구경에서 '다음으로 넘기자' 표시. 결과가 열린 뒤에만, 지금 구경 순번으로만.
        function validMemberUpdate() {
          let data = request.resource.data;
          let changed = data.diff(resource.data).affectedKeys();
          return changed.hasOnly(['assignmentDone', 'submitted', 'resultEntered', 'showcaseNext'])
            && (
              !changed.hasAny(['resultEntered'])
              || (data.resultEntered == true && resultsOpen(roomId))
            )
            && (
              !changed.hasAny(['showcaseNext'])
              || (
                data.showcaseNext is int
                && resultsOpen(roomId)
                && data.showcaseNext == roomData(roomId).get('showcaseIndex', -1)
              )
            )
            && (
              !changed.hasAny(['assignmentDone'])
              || (
                data.assignmentDone == true
                && roomData(roomId).get('phase', null) == 'assign'
              )
            )
            && (
              !changed.hasAny(['submitted'])
              || (
                data.submitted == true
                && exists(/databases/$(database)/documents/rooms/$(roomId)/submissions/$('s-a-' + uid))
              )
            );
        }

        allow read: if isMember(roomId);
        // 방장이 자기 자신을 추가하거나(방과 같은 batch로 만들 수 있도록 getAfter 사용),
        // 유효한 초대 코드로 참가할 때만 만들 수 있다.
        // 고른 동물의 animals 문서도 같은 batch에서 본인 것으로 만들어야 한다. (동물이 겹치지 않게)
        allow create: if signedIn()
          && request.auth.uid == uid
          && getAfter(/databases/$(database)/documents/rooms/$(roomId)/animals/$(request.resource.data.animal)).data.uid == uid
          && (
            getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == uid
            || validJoin()
          );
        // 본인의 '미션을 정했어요'·'제출했어요'·'결과 화면에 들어왔어요' 표시만 바꿀 수 있다.
        allow update: if signedIn()
          && request.auth.uid == uid
          && validMemberUpdate();
        allow delete: if false;
      }

      // 방에서 이미 누가 고른 동물. 문서 ID = 동물. 같은 동물은 한 번만 만들 수 있다. (update는 막혀 있다)
      // 참가 전(멤버가 아닐 때)에도 남은 동물을 보여줄 수 있게 로그인한 사람은 읽을 수 있다.
      // 어떤 동물이 쓰였는지만 담고, 누가 골랐는지(uid) 외에는 담지 않는다.
      match /animals/{animal} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid'])
          && request.resource.data.uid == request.auth.uid
          && getAfter(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)).data.animal == animal;
        allow update, delete: if false;
      }

      // 초대 코드. 방장만 만들고 조회하고 폐기할 수 있다. (참가자는 읽을 수 없다)
      // 만료 시각은 없다. 게임을 시작하면 앱이 폐기하고, validJoin도 대기 중인 방만 받는다.
      match /invites/{code} {
        // 링크(24자 코드)를 가진 사람은 그 코드 하나가 아직 살아 있는지 확인할 수 있다. (초대 화면의 '만료된 링크' 안내)
        // 코드를 모르면 찾을 수 없도록 목록 조회는 방장만 할 수 있다.
        allow get: if signedIn();
        allow list: if isHost(roomId);
        // 방을 만들 때 같은 batch에서 첫 초대 링크도 만들 수 있게 getAfter로 방장을 확인한다.
        // (방장은 바꿀 수 없으므로 기존 방에서는 isHost와 같다)
        allow create: if signedIn()
          && getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == request.auth.uid
          && code.matches('[A-Za-z0-9]{24}')
          && request.resource.data.keys().hasOnly(['code', 'createdBy', 'createdAt'])
          && request.resource.data.code == code
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isHost(roomId);
      }

      match /rounds/{roundId} {
        allow read: if isMember(roomId);
        allow create, update: if isHost(roomId);
        allow delete: if false;
      }

      // 목록으로 조회할 때는 where('receiverId', '==', uid)처럼
      // 규칙 조건과 맞는 쿼리만 허용된다.
      // (미션을 '미리 전체 공개'로 정한 방에서는 where 없이 전체를 조회할 수 있다)
      match /assignments/{assignmentId} {
        // 미션 배정 만들기 (docs/MISSION_ASSIGN.md). 모두 미션지정 단계(phase = assign)에서만 가능하다.
        // - 앱이 정하는 방식: 방장만, giverId는 null, 기본 제공 미션 id(missionId)
        // - 직접 부여: giverId가 본인인 문서만, 직접 쓴 미션 본문(missionText) 1~60자.
        //   '모두 같은 미션'이면 방장만 만들 수 있다.
        // 같은 문서 ID(a-받는사람)에는 한 번만 만들 수 있다. (update는 막혀 있다)
        function validAssignment() {
          let d = request.resource.data;
          let room = roomData(roomId);
          let missionId = d.get('missionId', null);
          let missionText = d.get('missionText', null);
          return isMember(roomId)
            && room.get('phase', null) == 'assign'
            && d.keys().hasOnly(['id', 'roomId', 'roundId', 'giverId', 'receiverId', 'missionId', 'missionText', 'order', 'createdAt'])
            && d.id == assignmentId
            && d.roomId == roomId
            && d.order == 1
            && d.createdAt == request.time
            && d.receiverId is string
            && (
              (
                room.settings.get('assigner', null) == 'app'
                && isHost(roomId)
                && d.giverId == null
                && missionId is string
                && missionText == null
              )
              || (
                room.settings.get('assigner', null) == 'players'
                && d.giverId == request.auth.uid
                && missionId == null
                && missionText is string
                && missionText.size() >= 1
                && missionText.size() <= 60
                && (room.settings.get('scope', null) == 'different' || isHost(roomId))
              )
            );
        }

        allow read: if isMember(roomId) && (
          resource.data.receiverId == request.auth.uid
          || resource.data.giverId == request.auth.uid
          || roomData(roomId).settings.get('visibility', null) == 'public'
          || resultsOpen(roomId)
        );
        allow create: if validAssignment();
        allow update, delete: if false;
      }

      // 사진 제출물. 사진 파일은 Cloud Storage에 있고 여기에는 경로만 둔다.
      match /submissions/{submissionId} {
        function validSubmission() {
          let d = request.resource.data;
          return isMember(roomId)
            && beforeDeadline(roomId)
            && d.keys().hasOnly(['id', 'assignmentId', 'ownerId', 'photoPath', 'submittedAt'])
            && d.id == submissionId
            && d.ownerId == request.auth.uid
            && d.submittedAt == request.time
            && d.photoPath == 'rooms/' + roomId + '/submissions/' + request.auth.uid + '/' + submissionId + '.jpg'
            && get(/databases/$(database)/documents/rooms/$(roomId)/assignments/$(d.assignmentId)).data.receiverId == request.auth.uid;
        }

        // 결과 공개 전에는 본인 제출물만 읽을 수 있다.
        allow read: if isMember(roomId) && (
          resource.data.ownerId == request.auth.uid
          || resultsOpen(roomId)
        );
        allow create: if validSubmission();
        allow update: if validSubmission() && resource.data.ownerId == request.auth.uid;
        allow delete: if false;
      }

      // 투표는 다른 사람의 사진을 볼 수 있는 결과 공개 이후에만 가능하다.
      // (투표 시점은 확정 필요: docs/SECURITY.md 열린 질문)
      match /votes/{voteId} {
        allow read: if isMember(roomId) && (
          resource.data.voterId == request.auth.uid
          || resultsOpen(roomId)
        );
        allow create: if isMember(roomId)
          && resultsOpen(roomId)
          && request.resource.data.voterId == request.auth.uid;
        allow update, delete: if false;
      }

      // 미션 구경의 '붐따'(별로예요). 문서 ID = 받는사람uid_누른사람uid 라서 한 사람에게 한 번만 누를 수 있다.
      // 결과가 열린 뒤에만, 본인 이름으로, 자기 자신에게는 누를 수 없다. 취소(삭제)·수정은 없다.
      match /boomdowns/{boomdownId} {
        allow read: if isMember(roomId) && resultsOpen(roomId);
        allow create: if isMember(roomId)
          && resultsOpen(roomId)
          && request.resource.data.keys().hasOnly(['targetId', 'voterId', 'createdAt'])
          && request.resource.data.voterId == request.auth.uid
          && request.resource.data.targetId is string
          && request.resource.data.targetId != request.auth.uid
          && boomdownId == request.resource.data.targetId + '_' + request.auth.uid
          && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.resource.data.targetId))
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      // 미션 구경의 '인정 투표'. 문서 ID = 받는사람uid_투표한사람uid 라서 한 사람에게 한 번만 투표한다.
      // 본인도 자기 미션에 투표한다.
      // 붐따가 30% 이상일 때만 열리는 것은 화면에서 막는다. (규칙은 문서 수를 셀 수 없다)
      match /judgments/{judgmentId} {
        allow read: if isMember(roomId) && resultsOpen(roomId);
        allow create: if isMember(roomId)
          && resultsOpen(roomId)
          && request.resource.data.keys().hasOnly(['targetId', 'voterId', 'accept', 'createdAt'])
          && request.resource.data.voterId == request.auth.uid
          && request.resource.data.accept is bool
          && request.resource.data.targetId is string
          && judgmentId == request.resource.data.targetId + '_' + request.auth.uid
          && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.resource.data.targetId))
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      // 시상 결과는 서버(Cloud Function)만 쓴다.
      match /awards/{awardId} {
        allow read: if isMember(roomId) && resultsOpen(roomId);
        allow write: if false;
      }
    }

    // 위에 없는 모든 경로는 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
