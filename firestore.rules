rules_version = '2';

// 초안: docs/SECURITY.md의 "배포 전 확인"을 마치기 전에는 실제 사용자 데이터에 쓰지 않는다.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 공통 함수 ----------
    function signedIn() {
      return request.auth != null;
    }

    function roomData(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data;
    }

    function isMember(roomId) {
      return signedIn()
        && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }

    function isHost(roomId) {
      return signedIn() && roomData(roomId).hostId == request.auth.uid;
    }

    // 결과 공개 시각(resultAt)이 지났는가. 값이 없으면 아직 공개 전으로 본다.
    function resultsOpen(roomId) {
      let resultAt = roomData(roomId).get('resultAt', null);
      return resultAt != null && resultAt <= request.time;
    }

    // 미션 수행 마감(deadlineAt) 전인가. 값이 없으면 마감 없음으로 본다.
    function beforeDeadline(roomId) {
      let deadlineAt = roomData(roomId).get('deadlineAt', null);
      return deadlineAt == null || request.time < deadlineAt;
    }

    // ---------- users ----------
    match /users/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.id == uid;
      allow delete: if false;
    }

    // ---------- missions (기본 제공 목록) ----------
    match /missions/{missionId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---------- rooms ----------
    match /rooms/{roomId} {
      allow get: if isMember(roomId);
      allow list: if false;
      // 방을 만들 때 모드(settings.mode)를 정한다. (docs/MODES.md)
      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.status == 'waiting'
        && request.resource.data.settings.mode in ['daily', 'oneshot', 'race', 'solo', 'endless'];
      // 방장만 수정할 수 있고, 방장 자체와 모드는 바꿀 수 없다.
      allow update: if isHost(roomId)
        && request.resource.data.hostId == resource.data.hostId
        && request.resource.data.settings.mode == resource.data.settings.mode;
      allow delete: if false;

      // 방 멤버(Player). 문서 ID = Firebase Auth uid
      match /members/{uid} {
        // 초대 링크로 참가하는 경우: 유효한 초대 코드를 문서에 담아 본인 문서를 만든다.
        // 코드는 방장만 읽을 수 있는 invites 문서의 존재 여부(exists)로 확인한다.
        function validJoin() {
          let d = request.resource.data;
          let code = d.get('inviteCode', null);
          return d.keys().hasOnly(['id', 'roomId', 'userId', 'animal', 'isHost', 'joinedAt', 'inviteCode'])
            && d.id == uid
            && d.userId == uid
            && d.roomId == roomId
            && d.isHost == false
            && d.joinedAt == request.time
            && code is string
            && code.matches('[A-Za-z0-9]{24}')
            && roomData(roomId).status == 'waiting'
            && exists(/databases/$(database)/documents/rooms/$(roomId)/invites/$(code))
            && get(/databases/$(database)/documents/rooms/$(roomId)/invites/$(code)).data.expiresAt > request.time;
        }

        // 본인 문서에서 바꿀 수 있는 것은 세 가지뿐이다.
        // - animal: 동물 캐릭터
        // - assignmentDone: '미션을 정했어요' 표시. true로만, 미션지정 단계(phase = assign)에서만.
        //   (docs/MISSION_ASSIGN.md)
        // - submitted: '제출했어요' 표시. true로만, 내 제출 문서(s-a-내uid)가 이미 있을 때만.
        //   다른 멤버에게 "제출했는지"만 알려 주는 용도이며, 사진 경로나 시각은 담지 않는다.
        //   (docs/RESULT_REVEAL.md)
        function validMemberUpdate() {
          let data = request.resource.data;
          let changed = data.diff(resource.data).affectedKeys();
          return changed.hasOnly(['animal', 'assignmentDone', 'submitted'])
            && (
              !changed.hasAny(['assignmentDone'])
              || (
                data.assignmentDone == true
                && roomData(roomId).get('phase', null) == 'assign'
              )
            )
            && (
              !changed.hasAny(['submitted'])
              || (
                data.submitted == true
                && exists(/databases/$(database)/documents/rooms/$(roomId)/submissions/$('s-a-' + uid))
              )
            );
        }

        allow read: if isMember(roomId);
        // 방장이 자기 자신을 추가하거나(방과 같은 batch로 만들 수 있도록 getAfter 사용),
        // 유효한 초대 코드로 참가할 때만 만들 수 있다.
        allow create: if signedIn()
          && request.auth.uid == uid
          && (
            getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.hostId == uid
            || validJoin()
          );
        // 본인의 동물 캐릭터와 '미션을 정했어요'·'제출했어요' 표시만 바꿀 수 있다.
        allow update: if signedIn()
          && request.auth.uid == uid
          && validMemberUpdate();
        allow delete: if false;
      }

      // 초대 코드. 방장만 만들고 조회하고 폐기할 수 있다. (참가자는 읽을 수 없다)
      match /invites/{code} {
        allow read: if isHost(roomId);
        allow create: if isHost(roomId)
          && code.matches('[A-Za-z0-9]{24}')
          && request.resource.data.keys().hasOnly(['code', 'createdBy', 'createdAt', 'expiresAt'])
          && request.resource.data.code == code
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.expiresAt > request.time
          && request.resource.data.expiresAt <= request.time + duration.value(7, 'd');
        allow update: if false;
        allow delete: if isHost(roomId);
      }

      match /rounds/{roundId} {
        allow read: if isMember(roomId);
        allow create, update: if isHost(roomId);
        allow delete: if false;
      }

      // 목록으로 조회할 때는 where('receiverId', '==', uid)처럼
      // 규칙 조건과 맞는 쿼리만 허용된다.
      // (미션을 '미리 전체 공개'로 정한 방에서는 where 없이 전체를 조회할 수 있다)
      match /assignments/{assignmentId} {
        // 미션 배정 만들기 (docs/MISSION_ASSIGN.md). 모두 미션지정 단계(phase = assign)에서만 가능하다.
        // - 앱이 정하는 방식: 방장만, giverId는 null, 기본 제공 미션 id(missionId)
        // - 직접 부여: giverId가 본인인 문서만, 직접 쓴 미션 본문(missionText) 1~60자.
        //   '모두 같은 미션'이면 방장만 만들 수 있다.
        // 같은 문서 ID(a-받는사람)에는 한 번만 만들 수 있다. (update는 막혀 있다)
        function validAssignment() {
          let d = request.resource.data;
          let room = roomData(roomId);
          let missionId = d.get('missionId', null);
          let missionText = d.get('missionText', null);
          return isMember(roomId)
            && room.get('phase', null) == 'assign'
            && d.keys().hasOnly(['id', 'roomId', 'roundId', 'giverId', 'receiverId', 'missionId', 'missionText', 'order', 'createdAt'])
            && d.id == assignmentId
            && d.roomId == roomId
            && d.order == 1
            && d.createdAt == request.time
            && d.receiverId is string
            && (
              (
                room.settings.get('assigner', null) == 'app'
                && isHost(roomId)
                && d.giverId == null
                && missionId is string
                && missionText == null
              )
              || (
                room.settings.get('assigner', null) == 'players'
                && d.giverId == request.auth.uid
                && missionId == null
                && missionText is string
                && missionText.size() >= 1
                && missionText.size() <= 60
                && (room.settings.get('scope', null) == 'different' || isHost(roomId))
              )
            );
        }

        allow read: if isMember(roomId) && (
          resource.data.receiverId == request.auth.uid
          || resource.data.giverId == request.auth.uid
          || roomData(roomId).settings.get('visibility', null) == 'public'
          || resultsOpen(roomId)
        );
        allow create: if validAssignment();
        allow update, delete: if false;
      }

      // 사진 제출물. 사진 파일은 Cloud Storage에 있고 여기에는 경로만 둔다.
      match /submissions/{submissionId} {
        function validSubmission() {
          let d = request.resource.data;
          return isMember(roomId)
            && beforeDeadline(roomId)
            && d.keys().hasOnly(['id', 'assignmentId', 'ownerId', 'photoPath', 'submittedAt'])
            && d.id == submissionId
            && d.ownerId == request.auth.uid
            && d.submittedAt == request.time
            && d.photoPath == 'rooms/' + roomId + '/submissions/' + request.auth.uid + '/' + submissionId + '.jpg'
            && get(/databases/$(database)/documents/rooms/$(roomId)/assignments/$(d.assignmentId)).data.receiverId == request.auth.uid;
        }

        // 결과 공개 전에는 본인 제출물만 읽을 수 있다.
        allow read: if isMember(roomId) && (
          resource.data.ownerId == request.auth.uid
          || resultsOpen(roomId)
        );
        allow create: if validSubmission();
        allow update: if validSubmission() && resource.data.ownerId == request.auth.uid;
        allow delete: if false;
      }
      // 결과 화면 이의제기. 반대/완료 표시는 본인 이름으로만 만들 수 있다.
      match /objections/{objectionId} {
        allow read: if isMember(roomId);
        allow create: if isMember(roomId)
          && request.resource.data.objectorId == request.auth.uid
          && request.resource.data.roomId == roomId
          && (
            (request.resource.data.get('done', false) == true
              && objectionId == request.auth.uid + '_done')
            ||
            (request.resource.data.submissionId is string
              && objectionId == request.auth.uid + '_' + request.resource.data.submissionId
              && get(/databases/$(database)/documents/rooms/$(roomId)/submissions/$(request.resource.data.submissionId)).data.ownerId != request.auth.uid)
          );
        allow update, delete: if false;
      }
      // 투표는 다른 사람의 사진을 볼 수 있는 결과 공개 이후에만 가능하다.
      // (투표 시점은 확정 필요: docs/SECURITY.md 열린 질문)
      match /votes/{voteId} {
        allow read: if isMember(roomId) && (
          resource.data.voterId == request.auth.uid
          || resultsOpen(roomId)
        );
        allow create: if isMember(roomId)
          && resultsOpen(roomId)
          && request.resource.data.voterId == request.auth.uid;
        allow update, delete: if false;
      }

      // 시상 결과는 서버(Cloud Function)만 쓴다.
      match /awards/{awardId} {
        allow read: if isMember(roomId) && resultsOpen(roomId);
        allow write: if false;
      }
    }

    // 위에 없는 모든 경로는 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
